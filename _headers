# Site-wide security headers + no HTML caching: pages inline their CSS/JS, so
# content edits only land if the HTML is always refetched.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.tile.openstreetmap.org; connect-src 'self' https://*.tile.openstreetmap.org https://cloudflareinsights.com https://challenges.cloudflare.com https://f1walk-stats-worker.maris-0ec.workers.dev; frame-src https://challenges.cloudflare.com; font-src 'self'; manifest-src 'self'; worker-src 'self'
  Cache-Control: no-cache, no-store, must-revalidate

# Images opt back out. Pages joins same-named headers from every matching
# block, so clear the inherited value with "! Cache-Control" first:
# https://developers.cloudflare.com/pages/configuration/headers/#detach-a-header
# OG previews get refetched constantly by link scrapers.
/icon.svg
  ! Cache-Control
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=604800

/preview.png
  ! Cache-Control
  Cache-Control: public, max-age=604800

/previews/*
  ! Cache-Control
  Cache-Control: public, max-age=604800

# Vendored JS only changes via a commit (check-vendored-leaflet.yml), so cache it.
/vendor/*
  ! Cache-Control
  Cache-Control: public, max-age=604800

/geo.js
  ! Cache-Control
  Cache-Control: public, max-age=604800
